# ==============================================================================
# Shipmate - AI-Powered Developer Shipping Assistant
# Environment & Secrets Template
#
# For Local Development (.env):
#   Copy this file to .env and fill in your values.
#
# For Streamlit Community Cloud (App Settings -> Secrets):
#   Paste the variables below into the Secrets editor:
#   GEMINI_API_KEY = "your_gemini_api_key_here"
#   GEMINI_MODEL = "gemini-1.5-flash"
# ==============================================================================

# Preferred Provider: gemini | openai | demo
DEFAULT_PROVIDER=gemini

# Google Gemini API Key (Recommended)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# OpenAI API Key (Optional alternate provider)
# Get a key at: https://platform.openai.com/
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
